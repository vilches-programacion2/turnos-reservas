# Copiar a .env.integracion. Nunca commitear valores reales.
# Repos clonados como carpetas hermanas, o configurar otra ruta.
CATALOGO_CONTEXT=../turnos-catalogo

RESERVAS_DB_NAME=reservas
RESERVAS_DB_USER=reservas
RESERVAS_DB_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_LOCAL
RESERVAS_DB_PORT=5433
RESERVAS_PORT=8081

CATALOGO_DB_NAME=catalogo
CATALOGO_DB_USER=catalogo
CATALOGO_DB_PASSWORD=REEMPLAZAR_CON_OTRA_CLAVE_LOCAL
CATALOGO_DB_PORT=5434
CATALOGO_PORT=8082

# UID/GID del dueño de los secretos: completar con id -u / id -g (no root).
APP_UID=
APP_GID=
APP_LOG_LEVEL=INFO

# Solo la privada se monta en Reservas; ambos reciben la misma pública.
JWT_PRIVATE_KEY_SOURCE=./secrets/private.pem
JWT_PUBLIC_KEY_SOURCE=./secrets/public.pem
JWT_ISSUER=https://turnos-reservas.local
JWT_AUDIENCE=turnos-reservas
JWT_CATALOG_AUDIENCE=turnos-catalogo
JWT_TIME_TO_LIVE=30m
CATALOGO_CONNECT_TIMEOUT=3s
CATALOGO_READ_TIMEOUT=5s

# VPN y cuenta ya registrada: ruta externa al JWT técnico existente, sin Bearer.
# La misma cuenta/token se utilizará en Reservas al implementar RES-06.
CATEDRA_ENABLED=true
CATEDRA_BASE_URL=
CATEDRA_TOKEN_SOURCE=
CATEDRA_CONNECT_TIMEOUT=3s
CATEDRA_READ_TIMEOUT=5s

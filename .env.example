# Copiar a .env para Docker Compose. Reemplazar antes de ejecutar.
DB_USER=reservas
DB_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_LOCAL
DB_NAME=reservas
DB_PORT=5433
APP_PORT=8081
APP_LOG_LEVEL=INFO

# Solo para ejecutar Java en el host (Spring no carga .env automáticamente).
DB_URL=jdbc:postgresql://localhost:5433/reservas

# Claves RSA PEM propias: privada PKCS#8 y pública X.509, mínimo 2048 bits.
# Generar en ./secrets/: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out secrets/private.pem
# Pública: openssl pkey -in secrets/private.pem -pubout -out secrets/public.pem
# Compose monta ./secrets/ en /run/secrets/ (solo lectura).
# Dar lectura de la privada al grupo 10001 del contenedor, manteniéndola sin acceso para otros.
# Para Java en el host, reemplazar /run/secrets/ por la ruta local absoluta de las claves.
JWT_PRIVATE_KEY=file:/run/secrets/private.pem
JWT_PUBLIC_KEY=file:/run/secrets/public.pem
JWT_ISSUER=https://turnos-reservas.local
JWT_AUDIENCE=turnos-reservas
JWT_TIME_TO_LIVE=30m
